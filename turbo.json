{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["packages/tsconfig/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "codegen": {
      "cache": true
    },
    "typecheck": {},
    "test": {
      "env": ["DATABASE_URL", "S3_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,js,mjs}", ".oxlintrc.json", "!**/node_modules/**", "!**/dist/**"]
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": ["E2E_PORT"]
    }
  }
}
