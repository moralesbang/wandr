{
  "openapi": "3.1.0",
  "info": {
    "title": "Wandr API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/CheckStatus"
              },
              "bucket": {
                "$ref": "#/components/schemas/CheckStatus"
              }
            },
            "required": [
              "database",
              "bucket"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "CheckStatus": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Whether the API, its database and its bucket answer",
        "responses": {
          "200": {
            "description": "Everything answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "The database or the bucket doesn’t answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
