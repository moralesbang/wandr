{
  "name": "wandr",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.5",
      "oxlint": "1.95.0",
      "typescript": "6.0.3",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "lint": "oxlint --deny-warnings",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "services": "docker compose up -d --wait && docker compose wait buckets",
    "db:migrate": "bun run --cwd apps/api db:migrate"
  },
  "devDependencies": {
    "@railway/cli": "5.75.0",
    "oxfmt": "0.80.0",
    "oxlint": "catalog:",
    "railway": "3.17.0",
    "turbo": "2.11.13"
  },
  "packageManager": "bun@1.4.5"
}
