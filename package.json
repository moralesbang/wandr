{
  "name": "wandr",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "factory/cli"
    ],
    "catalog": {
      "@playwright/test": "1.65.1",
      "@types/bun": "1.4.5",
      "@typescript/native": "npm:typescript@7.0.2",
      "oxlint": "1.95.0",
      "vitest": "5.1.1",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "lint": "oxlint --deny-warnings",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "services": "docker compose up -d --wait && docker compose wait buckets",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "factory": "bun factory/cli/src/main.ts"
  },
  "devDependencies": {
    "@railway/cli": "5.75.0",
    "oxfmt": "0.80.0",
    "oxlint": "catalog:",
    "railway": "3.17.0",
    "turbo": "2.11.13"
  },
  "packageManager": "bun@1.4.5"
}
